{
  "name": "trainlink-formatting",
  "version": "1.0.0",
  "description": "Prettier configuration for TrainLink project",
  "private": true,
  "devDependencies": {
    "prettier": "^3.1.0",
    "prettier-plugin-java": "^2.5.0",
    "@prettier/plugin-xml": "^3.2.2"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{java,xml,fxml,json,md}\"",
    "format-check": "prettier --check \"**/*.{java,xml,fxml,json,md}\""
  }
}
