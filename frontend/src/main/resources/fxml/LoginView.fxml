<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<VBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="me.ensah.ui.LoginController" styleClass="root">

    <!-- Header -->
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
        <padding>
            <Insets top="12" right="20" bottom="12" left="20" />
        </padding>
        <Label text="🚄" styleClass="logo-icon" onMouseClicked="#goHome" />
        <Label text="TrainReserve" styleClass="brand" onMouseClicked="#goHome" />
        <Pane HBox.hgrow="ALWAYS" />
        <Button fx:id="headerLoginBtn" text="Login" styleClass="btn-secondary" disable="true" />
        <Button fx:id="headerRegisterBtn" text="Register" styleClass="btn-primary"
            onAction="#goRegister" />
        <Button fx:id="headerLogoutBtn" text="Logout" styleClass="btn-secondary" onAction="#logout"
            visible="false" managed="false" />
    </HBox>

    <!-- Content -->
    <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <VBox spacing="18" alignment="CENTER" maxWidth="520" prefWidth="460">
            <padding>
                <Insets top="40" right="20" bottom="40" left="20" />
            </padding>
            <VBox styleClass="search-card" spacing="14" maxWidth="520">
                <padding>
                    <Insets top="24" right="28" bottom="24" left="28" />
                </padding>

                <Label text="Sign in" styleClass="card-title">
                    <font>
                        <Font name="System Bold" size="16" />
                    </font>
                </Label>

                <VBox spacing="8">
                    <Label text="Email" styleClass="input-label" />
                    <TextField fx:id="emailField" promptText="a@a.com" styleClass="combo-input" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Password" styleClass="input-label" />
                    <PasswordField fx:id="passwordField" promptText="••••••"
                        styleClass="combo-input" />
                </VBox>

                <Button fx:id="submitBtn" text="Sign in" onAction="#onSubmit"
                    styleClass="btn-search" prefHeight="24">
                    <VBox.margin>
                        <Insets top="10" />
                    </VBox.margin>
                </Button>

                <HBox spacing="6">
                    <Label text="No account?" styleClass="empty-hint" />
                    <Hyperlink fx:id="toRegisterLink" text="Create one" />
                </HBox>

                <!-- Development Quick Login Buttons -->
                <Separator>
                    <VBox.margin>
                        <Insets top="10" bottom="10" />
                    </VBox.margin>
                </Separator>

                <Label text="🚀 Quick Login (Dev Only)"
                    style="-fx-font-size: 12px; -fx-text-fill: #9ca3af; -fx-font-weight: 600;" />

                <HBox spacing="12" alignment="CENTER">
                    <Button fx:id="quickAdminBtn" text="👨‍💼 Admin" onAction="#quickAdminLogin"
                        style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(249, 115, 22, 0.3), 6, 0, 0, 2);"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" />

                    <Button fx:id="quickClientBtn" text="👤 Client" onAction="#quickClientLogin"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8px; -fx-padding: 10 20; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(59, 130, 246, 0.3), 6, 0, 0, 2);"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>