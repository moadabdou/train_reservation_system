<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import me.ensah.ui.components.Btn?>
<?import me.ensah.ui.components.SidebarItem?>

<VBox xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:id="sidebarContainer"
    fx:controller="me.ensah.ui.controllers.SidebarController"
    style="-fx-background-color: #fff7ed; 
             -fx-border-color: #e5e7eb; 
             -fx-border-width: 0 2 0 0;
             -fx-border-radius: 15;
             -fx-background-radius: 15;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 2, 0);"
    prefWidth="270"
    minWidth="80"
    spacing="16"
    alignment="TOP_CENTER">

    <VBox alignment="CENTER" spacing="12" style="-fx-padding: 20 14 14 14;" prefHeight="80">
        <!-- Text Box - Visible when expanded -->
        <VBox fx:id="headerTextBox" alignment="CENTER">
            <Label fx:id="brandLabel" text="TrainLink"
                style="-fx-font-size: 26px;
                       -fx-font-weight: bold;
                       -fx-text-fill: #f97316;
                       -fx-cursor: hand;
                          " />
            <Label text="Journey Partner"
                style="-fx-font-size: 11px;
                       -fx-text-fill: #9ca3af;
                       -fx-font-weight: 800;
                       -fx-cursor: hand;" />
        </VBox>

        <!-- Train Icon - Visible when collapsed -->
        <Label fx:id="trainIcon" text="T"
            style="-fx-font-size: 48px;
                   -fx-font-weight: bold;
                   -fx-text-fill: #f97316;
                   -fx-cursor: hand;"
            visible="false"
            managed="false"
            alignment="CENTER" />

    </VBox>    <!-- Menu Items Container - Centered when collapsed -->
    <VBox fx:id="menuBox" spacing="8" style="-fx-padding: 0 8 0 8;"
        VBox.vgrow="ALWAYS" alignment="TOP_CENTER">  <!-- Added TOP_CENTER -->
        <!-- Menu items will be created programmatically -->
    </VBox>


    <!-- sidebar footer -->
    <VBox style="-fx-padding: 14;" spacing="8" alignment="CENTER">  <!-- Added CENTER -->
        <Label text="v1.0.0"
            style="-fx-text-fill: #9ca3af; -fx-font-size: 10px; -fx-alignment: center;"
            HBox.hgrow="ALWAYS" />
    </VBox>

</VBox>