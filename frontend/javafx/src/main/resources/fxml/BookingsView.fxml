<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="me.ensah.ui.BookingsController" styleClass="root" style="-fx-padding: 0;">

    <!-- LEFT SIDEBAR -->
    <left>
        <fx:include fx:id="sidebar" source="components/sidebar.fxml" />
    </left>

    <!-- CENTER CONTENT -->
    <center>
        <VBox>
            <!-- Header Component -->
            <fx:include fx:id="header" source="components/header.fxml"/>

            <!-- Main Content -->
            <HBox spacing="12" VBox.vgrow="ALWAYS" alignment="CENTER">
                <VBox styleClass="content-area" maxWidth="960" prefWidth="900" spacing="16" VBox.vgrow="ALWAYS">
                    <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>

                    <Label text="My Bookings" styleClass="card-title">
                        <font><Font name="System Bold" size="14" /></font>
                    </Label>

                    <SplitPane VBox.vgrow="ALWAYS" dividerPositions="0.55">
                        <items>
                            <VBox spacing="8" styleClass="search-card">
                                <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                                <Label text="Recent" styleClass="input-label"/>
                                <ListView fx:id="bookingList" prefWidth="340" styleClass="booking-list"/>
                            </VBox>
                            <VBox spacing="10" styleClass="search-card" VBox.vgrow="ALWAYS">
                                <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <Label fx:id="detailsTitle" styleClass="section-title"/>
                                    <Label fx:id="detailsStatus"/>
                                </HBox>
                                <Label fx:id="detailsMeta" styleClass="meta-text"/>
                                <Label text="Passengers" styleClass="input-label"/>
                                <ListView fx:id="passengersList" styleClass="passenger-list"/>
                                <HBox alignment="CENTER_RIGHT" spacing="10">
                                    <Button fx:id="receiptBtn" text="Download Receipt" styleClass="btn-secondary" onAction="#downloadReceipt" visible="false" managed="false" minWidth="-Infinity"/>
                                    <Button fx:id="trackBtn" text="Track Journey" styleClass="btn-primary" onAction="#trackSelected" visible="false" managed="false" minWidth="-Infinity"/>
                                    <Button fx:id="cancelBtn" text="Cancel Booking" styleClass="btn-secondary" onAction="#cancelSelected" visible="false" managed="false" minWidth="-Infinity"/>
                                </HBox>
                            </VBox>
                        </items>
                    </SplitPane>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>